# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

# --- Backend (apps/api) ---
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg2://go_os:go_os@localhost:5432/go_os
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
LOG_JSON=true

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=go_os
POSTGRES_PASSWORD=go_os
POSTGRES_DB=go_os

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Stage 2: Data Infrastructure ---
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
# Required for economic data ingestion to actually fetch data; the app
# still runs and gives a clear error without it.
FRED_API_KEY=

# --- Stage 4: Market Core ---
# Free key from https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# --- Broker credentials: DO NOT ADD THESE IN BUILD 01 ---
# Broker/exchange credentials are introduced only at the Execution build
# stage, behind the broker-adapter interface, and never in plaintext.
